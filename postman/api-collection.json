{
  "info": {
    "name": "Parts API",
    "description": "Collection for testing the Parts API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "General",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          }
        },
        {
          "name": "Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "status"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"clientName\": \"Test Client\",\n    \"clientEmail\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api-clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api-clients"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Parts",
      "item": [
        {
          "name": "Get All Parts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/parts?type=controller&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "parts"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "controller",
                  "description": "Filter parts by type (e.g., controller, sensor)",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Limit the number of results returned (1-20)",
                  "disabled": false
                }
              ]
            }
          }
        },
        {
          "name": "Get Single Part",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/parts/:partId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "parts",
                ":partId"
              ],
              "variable": [
                {
                  "key": "partId",
                  "value": "1",
                  "description": "ID of the part"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"orderId\", jsonData.orderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"partId\": 1,\n    \"customerName\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "Get Single Order",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/:orderId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                ":orderId"
              ],
              "variable": [
                {
                  "key": "orderId",
                  "value": "{{orderId}}",
                  "description": "ID of the order"
                }
              ]
            }
          }
        },
        {
          "name": "Update Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customerName\": \"Jane Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/:orderId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                ":orderId"
              ],
              "variable": [
                {
                  "key": "orderId",
                  "value": "{{orderId}}",
                  "description": "ID of the order"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/orders/:orderId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                ":orderId"
              ],
              "variable": [
                {
                  "key": "orderId",
                  "value": "{{orderId}}",
                  "description": "ID of the order"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
